---
interface Props {
  href?: string;
  class?: string;
  tag?: "div" | "article" | "li";
}

const { href, class: className, tag: Tag = "div" } = Astro.props;
---

<Tag class:list={["card", { "card-link": Boolean(href) }, className]}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: clamp(1.4rem, 1.2rem + 0.8vw, 2rem);
    height: 100%;
    transition: box-shadow 0.2s ease;
  }

  :global(.tone-band) .card {
    background: var(--color-band-raised);
    border-color: var(--color-band-border);
  }

  .card-link:hover {
    box-shadow: 0 6px 24px -12px rgb(23 52 46 / 0.35);
  }

  :global(.tone-band) .card-link:hover {
    box-shadow: 0 6px 24px -12px rgb(0 0 0 / 0.5);
  }
</style>
