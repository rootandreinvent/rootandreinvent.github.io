---
import { site } from "../config/site";

type Logo = { name: string; src: string };

/* Placeholder only. Add real logos with written permission before turning on site.features.testimonials. */
const logos: Logo[] = [];
---

{
  site.features.testimonials && (
    <div class="logo-strip">
      <p class="logo-title">Teams I've worked with</p>
      {logos.length ? (
        <ul role="list">
          {logos.map((logo) => (
            <li>
              <img src={logo.src} alt={logo.name} height="32" loading="lazy" />
            </li>
          ))}
        </ul>
      ) : (
        <p class="logo-empty">[TODO: logos with permission]</p>
      )}
    </div>
  )
}

<style>
  .logo-strip {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline-light);
  }

  .logo-title {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-800);
  }

  ul {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 3.5rem;
  }

  img {
    height: 32px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }
</style>
