---
import PlaceholderNote from "./PlaceholderNote.astro";
import { showPending } from "../lib/placeholders";
import type { Faq } from "../data/faq";

interface Props {
  items: Faq[];
  title?: string;
}

const { items, title = "Frequently asked" } = Astro.props;
const answered = items.filter((i) => i.a);
const visible = showPending ? items : answered;
---

{
  visible.length > 0 && (
    <div class="faq">
      <h2>{title}</h2>
      {visible.map((item) => (
        <details>
          <summary>
            <span>{item.q}</span>
            <span class="marker" aria-hidden="true" />
          </summary>
          <div class="answer">{item.a ? <p>{item.a}</p> : <PlaceholderNote text="[KELSEY TO ANSWER]" />}</div>
        </details>
      ))}
    </div>
  )
}

<style>
  .faq {
    max-width: 860px;
  }

  .faq h2 {
    margin-bottom: 2rem;
  }

  details {
    border-top: 1px solid var(--hairline-light);
  }

  details:last-of-type {
    border-bottom: 1px solid var(--hairline-light);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 72px;
    padding: 0.75rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem);
    color: var(--color-heading);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .marker {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--hairline-gold);
    transition: transform 0.4s var(--ease-out), background-color 0.3s ease;
  }

  .marker::before,
  .marker::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--gold-800);
    transform: translate(-50%, -50%);
  }

  .marker::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform 0.4s var(--ease-out);
  }

  details[open] .marker {
    background: color-mix(in srgb, var(--gold-500) 14%, transparent);
  }

  details[open] .marker::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .answer {
    padding: 0 3.5rem 1.5rem 0;
  }

  .answer p {
    margin: 0;
  }
</style>
