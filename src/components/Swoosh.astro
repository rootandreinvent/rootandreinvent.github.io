---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["swoosh", className]} viewBox="0 0 320 16" aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <path d="M2 11.5C60 4.5 150 1.8 220 3.2c38 .8 70 3.2 98 6.6-30-1.6-62-2.6-98-2.4C152 7.8 70 10.4 2 14.2z" />
</svg>

<style>
