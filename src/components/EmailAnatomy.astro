---
const parts = [
  {
    key: "reason",
    label: "1 · The reason",
    explain: "Their news, and why it matters. One specific reason from your research proves it wasn't sent to a thousand people.",
  },
  {
    key: "proof",
    label: "2 · The proof",
    explain: "A similar customer, the challenge they had, and a measurable result. Same industry, ideally the same size.",
  },
  {
    key: "ask",
    label: "3 · The ask",
    explain: "15 to 20 minutes, to see if you can repeat that success for them. Nothing bigger.",
  },
] as const;
---

<div class="anatomy" data-anatomy>
  <figure class="email-wrap" aria-labelledby="email-anatomy-caption">
    <div class="email">
      <div class="chrome" aria-hidden="true">
        <span class="dots"><span></span><span></span><span></span></span>
        <span class="chrome-title">New message</span>
      </div>
      <dl class="email-head">
        <div class="row">
          <dt>From</dt>
          <dd>Alex</dd>
        </div>
        <div class="row">
          <dt>To</dt>
          <dd>Dana</dd>
        </div>
        <div class="row">
          <dt>Subject</dt>
          <dd class="subject">Your second warehouse</dd>
        </div>
      </dl>
      <div class="email-body">
        <p>Hi Dana,</p>
        <p>
          <mark class="hl hl-reason" data-part="reason">
            <span class="tag">Reason</span>
            I saw Harlan Freight just opened a second warehouse. When another regional freight company did the same, their dispatchers were still planning routes by hand a year later.
          </mark>
        </p>
        <p>
          <mark class="hl hl-proof" data-part="proof">
            <span class="tag">Proof</span>
            They moved route planning into one system, and missed delivery windows dropped from about one in five to one in twenty, with the same number of drivers.
          </mark>
        </p>
        <p>
          <mark class="hl hl-ask" data-part="ask">
            <span class="tag">Ask</span>
            Would you be open to 15 to 20 minutes to see if we can repeat that for Harlan?
          </mark>
        </p>
        <p>Thanks,<br />Alex</p>
      </div>
    </div>
    <figcaption id="email-anatomy-caption" class="fictional">
      A made-up example. The company, customer and numbers are fictional.
    </figcaption>
  </figure>

  <ol class="legend" role="list">
    {
      parts.map((part) => (
        <li class={`legend-item legend-${part.key}`} data-legend={part.key}>
          <button type="button" class="legend-btn" data-target={part.key} aria-pressed="false">
            <span class={`swatch swatch-${part.key}`} aria-hidden="true" />
            {part.label}
          </button>
          <p class="explain">{part.explain}</p>
        </li>
      ))
    }
  </ol>

  <svg class="connectors" aria-hidden="true" data-connectors></svg>
</div>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-anatomy]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".legend-btn")];
    const marks = [...root.querySelectorAll<HTMLElement>("[data-part]")];
    const legends = [...root.querySelectorAll<HTMLElement>("[data-legend]")];
    const svg = root.querySelector<SVGSVGElement>("[data-connectors]");
    let pinned: string | null = null;
    let touched = false;

    const select = (target: string | null) => {
      root.classList.toggle("is-focused", target !== null);
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.target === target && target === pinned)));
      marks.forEach((m) => m.classList.toggle("is-active", m.dataset.part === target));
      legends.forEach((l) => l.classList.toggle("is-active", l.dataset.legend === target));
      svg?.querySelectorAll("path").forEach((p) => p.classList.toggle("is-active", p.dataset.part === target));
    };

    buttons.forEach((button) => {
      const key = button.dataset.target ?? null;
      button.addEventListener("click", () => {
        touched = true;
        pinned = pinned === key ? null : key;
        select(pinned);
      });
      const preview = () => {
        touched = true;
        select(key);
      };
      const restore = () => select(pinned);
      button.addEventListener("mouseenter", preview);
      button.addEventListener("focus", preview);
      button.addEventListener("mouseleave", restore);
      button.addEventListener("blur", restore);
    });

    /* Connector lines from each annotation to its highlight (side-by-side layout only). */
    const draw = () => {
      if (!svg) return;
      const wide = matchMedia("(min-width: 1024px)").matches;
      svg.replaceChildren();
      if (!wide) return;
      const box = root.getBoundingClientRect();
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      legends.forEach((legend) => {
        const key = legend.dataset.legend;
        const mark = marks.find((m) => m.dataset.part === key);
        if (!mark) return;
        const a = mark.getBoundingClientRect();
        const b = legend.getBoundingClientRect();
        const x1 = a.right - box.left;
        const y1 = a.top + a.height / 2 - box.top;
        const x2 = b.left - box.left;
        const y2 = b.top + 28 - box.top;
        const mid = (x1 + x2) / 2;
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", `M${x1} ${y1}C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}`);
        path.dataset.part = key;
        svg.append(path);
      });
      select(root.classList.contains("is-focused") ? (marks.find((m) => m.classList.contains("is-active"))?.dataset.part ?? null) : null);
    };

    draw();
    window.addEventListener("resize", draw);
    document.fonts?.ready.then(draw);

    /* Step through Reason, Proof and Ask once when it scrolls into view. */
    if (!reduced && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          observer.disconnect();
          const order = ["reason", "proof", "ask"];
          order.forEach((key, i) => {
            setTimeout(() => {
              if (!touched) select(key);
            }, 600 + i * 1500);
          });
          setTimeout(() => {
            if (!touched) select(null);
          }, 600 + order.length * 1500);
        },
        { threshold: 0.5 },
      );
      observer.observe(root.querySelector(".email") ?? root);
    }
  });
</script>

<style>
  .anatomy {
    position: relative;
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (min-width: 1024px) {
    .anatomy {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: clamp(4rem, 7vw, 7rem);
      align-items: center;
    }
  }

  .email-wrap {
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .email {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-media);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    background: var(--bone-100);
    border-bottom: 1px solid var(--color-border);
  }

  .dots {
    display: inline-flex;
    gap: 0.45rem;
  }

  .dots span {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .dots span:first-child {
    background: color-mix(in srgb, var(--clay-500) 70%, var(--paper));
  }
  .dots span:nth-child(2) {
    background: color-mix(in srgb, var(--gold-500) 70%, var(--paper));
  }
  .dots span:nth-child(3) {
    background: color-mix(in srgb, var(--moss-500) 70%, var(--paper));
  }

  .chrome-title {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-body);
  }

  .email-head {
    margin: 0;
    padding: 0.4rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-ui);
  }

  .row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding: 0.55rem 0;
  }

  .row + .row {
    border-top: 1px solid color-mix(in srgb, var(--color-border) 60%, transparent);
  }

  dt {
    width: 4.5rem;
    flex: none;
    font-size: 0.82rem;
    color: var(--color-body);
  }

  dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-strong);
  }

  .subject {
    font-weight: 600;
  }

  .email-body {
    padding: 1.5rem;
    font-family: var(--font-ui);
    color: var(--color-strong);
  }

  @media (min-width: 640px) {
    .email-body {
      padding: 2rem 2rem 2.25rem;
    }
  }

  .email-body p {
    margin: 0 0 1rem;
  }

  .email-body p:last-child {
    margin-bottom: 0;
  }

  .hl {
    display: block;
    color: var(--color-strong);
    padding: 0.85rem 1rem;
    border-radius: var(--radius-card);
    transition:
      opacity 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s var(--ease-out);
  }

  .hl-reason {
    background: var(--hl-reason);
  }
  .hl-proof {
    background: var(--hl-proof);
  }
  .hl-ask {
    background: var(--hl-ask);
  }

  .tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-strong);
    background: var(--paper);
    border-radius: var(--radius-button);
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.4rem;
    box-shadow: var(--shadow-sm);
  }

  .anatomy.is-focused .hl:not(.is-active) {
    opacity: 0.35;
  }

  .hl.is-active {
    box-shadow: 0 0 0 1.5px var(--forest-900);
    transform: translateX(4px);
  }

  .fictional {
    margin-top: 1rem;
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--color-body);
  }

  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    position: relative;
    z-index: 1;
  }

  .legend-item {
    padding: 1.4rem 0;
    border-top: 1px solid var(--hairline-light);
    transition: opacity 0.35s ease;
  }

  .legend-item:last-child {
    border-bottom: 1px solid var(--hairline-light);
  }

  .anatomy.is-focused .legend-item:not(.is-active) {
    opacity: 0.5;
  }

  .legend-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--color-heading);
    cursor: pointer;
  }

  .legend-btn[aria-pressed="true"] {
    font-style: italic;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--forest-900) 25%, transparent);
  }
  .swatch-reason {
    background: var(--hl-reason);
  }
  .swatch-proof {
    background: var(--hl-proof);
  }
  .swatch-ask {
    background: var(--hl-ask);
  }

  .explain {
    margin: 0.35rem 0 0;
    font-size: 1rem;
  }

  .connectors {
    display: none;
  }

  @media (min-width: 1024px) {
    .connectors {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: visible;
      z-index: 2;
    }
  }

  .connectors :global(path) {
    fill: none;
    stroke: color-mix(in srgb, var(--forest-900) 22%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    transition: stroke 0.3s ease;
  }

  .connectors :global(path.is-active) {
    stroke: var(--gold-700);
    stroke-dasharray: none;
    stroke-width: 1.5;
  }
</style>
