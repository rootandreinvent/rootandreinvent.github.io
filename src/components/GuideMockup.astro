---
import { Image } from "astro:assets";
import mark from "../assets/logo-mark.png";
---

<div class="guide-mockup" aria-hidden="true">
  <div class="sheet sheet-3">
    <span class="bar w80"></span><span class="bar w60"></span><span class="bar w90"></span><span class="bar w40"></span>
  </div>
  <div class="sheet sheet-2">
    <span class="bar w70"></span>
    <span class="block reason"></span>
    <span class="block proof"></span>
    <span class="block ask"></span>
  </div>
  <div class="sheet sheet-1">
    <Image src={mark} alt="" width={44} height={44} densities={[1, 2]} class="sheet-mark" />
    <span class="sheet-eyebrow">Free guide</span>
    <span class="bar heading w90"></span>
    <span class="bar heading w60"></span>
    <span class="sheet-rule"></span>
    <span class="bar w80"></span><span class="bar w70"></span><span class="bar w50"></span>
    <span class="sheet-brand">Root &amp; Reinvent</span>
  </div>
</div>

<style>
  .guide-mockup {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 3 / 3.6;
    margin-inline: auto;
  }

  .sheet {
    position: absolute;
    inset: 4% 8% 4% 8%;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 12% 11%;
    border-radius: 6px;
    background: var(--paper);
    box-shadow:
      0 1px 0 color-mix(in srgb, var(--forest-950) 6%, transparent),
      0 30px 60px -30px rgb(0 0 0 / 0.6);
    transition: transform 0.9s var(--ease-out);
  }

  .sheet-3 {
    transform: rotate(9deg) translate(12%, 2%);
    background: var(--bone-100);
  }

  .sheet-2 {
    transform: rotate(4deg) translate(6%, 1%);
    background: var(--bone-50);
  }

  .sheet-1 {
    transform: rotate(-3deg);
  }

  .guide-mockup:hover .sheet-3 {
    transform: rotate(12deg) translate(16%, 2%);
  }

  .guide-mockup:hover .sheet-2 {
    transform: rotate(6deg) translate(9%, 1%);
  }

  .sheet-mark {
    border-radius: 999px;
    margin-bottom: 0.5rem;
  }

  .sheet-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-800);
  }

  .sheet-brand {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--forest-900);
  }

  .sheet-rule {
    width: 28px;
    height: 1.5px;
    margin: 0.4rem 0;
    background: var(--gold-500);
  }

  .bar {
    display: block;
    height: 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--forest-900) 12%, transparent);
  }

  .bar.heading {
    height: 14px;
    background: color-mix(in srgb, var(--forest-900) 75%, transparent);
  }

  .block {
    display: block;
    height: 18%;
    border-radius: 6px;
  }

  .reason {
    background: var(--hl-reason);
  }
  .proof {
    background: var(--hl-proof);
  }
  .ask {
    background: var(--hl-ask);
    height: 10%;
  }

  .w90 {
    width: 90%;
  }
  .w80 {
    width: 80%;
  }
  .w70 {
    width: 70%;
  }
  .w60 {
    width: 60%;
  }
  .w50 {
    width: 50%;
  }
  .w40 {
    width: 40%;
  }
</style>
