---
import Icon from "./Icon.astro";
import { url } from "../lib/url";

interface Props {
  service: { title: string; slug: string; audience: string; summary: string };
  index?: number;
  featured?: boolean;
}

const { service, index, featured = false } = Astro.props;
const audience = service.audience.charAt(0).toLowerCase() + service.audience.slice(1);
---

<article class:list={["service-card", { featured, "tone-dark": featured }]} data-reveal>
  {index !== undefined && <span class="index" aria-hidden="true">0{index + 1}</span>}
  <p class="audience">For {audience}</p>
  <h3>
    <a class="stretched" href={url(`/work-with-me/#${service.slug}`)}>{service.title}</a>
  </h3>
  <p class="summary">{service.summary}</p>
  <span class="more" aria-hidden="true">
    Learn more <Icon name="arrow" size={16} />
  </span>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out),
      border-color 0.45s ease;
  }

  .service-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: var(--radius-card);
    right: var(--radius-card);
    height: 2px;
    background: var(--gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease-out);
  }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--hairline-gold);
  }

  .service-card:hover::before,
  .service-card:focus-within::before {
    transform: scaleX(1);
  }

  .featured {
    background:
      radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--gold-500) 12%, transparent), transparent 70%),
      var(--forest-900);
    border-color: var(--forest-900);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 1024px) {
    .featured {
      margin-block: -1.5rem;
      padding-block: calc(clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem) + 1.5rem);
    }
  }

  .index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--gold-800);
    margin-bottom: 2.5rem;
  }

  .featured .index {
    color: var(--gold-500);
  }

  .audience {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--gold-800);
    margin-bottom: 0.9rem;
  }

  .featured .audience {
    color: var(--gold-500);
  }

  h3 {
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .stretched {
    color: inherit !important;
    text-decoration: none;
  }

  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .stretched:focus-visible {
    outline: none;
  }

  .stretched:focus-visible::after {
    outline: 2px solid var(--gold-800);
    outline-offset: 4px;
  }

  .featured .stretched:focus-visible::after {
    outline-color: var(--gold-500);
  }

  .summary {
    margin-bottom: 2rem;
  }

  .more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-ui);
    font-weight: 600;
    color: var(--forest-900);
  }

  .featured .more {
    color: var(--gold-500);
  }

  .more :global(.icon) {
    transition: transform 0.35s var(--ease-out);
  }

  .service-card:hover .more :global(.icon) {
    transform: translateX(4px);
  }
</style>
