---
import Card from "./Card.astro";
import { url } from "../lib/url";

interface Props {
  service: { title: string; slug: string; audience: string; summary: string };
}

const { service } = Astro.props;
---

<Card tag="article" class="service-card">
  <p class="audience">For {service.audience.charAt(0).toLowerCase() + service.audience.slice(1)}</p>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <a class="more" href={url(`/work-with-me/#${service.slug}`)}>
    Learn more<span class="visually-hidden"> about {service.title}</span> &rarr;
  </a>
</Card>

<style>
  .audience {
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-teal);
    margin-bottom: 0.6rem;
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-ui);
    font-weight: 600;
  }
</style>
