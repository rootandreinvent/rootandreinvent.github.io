---
import Section from "./Section.astro";
import Eyebrow from "./Eyebrow.astro";

interface Props {
  id: string;
  title: string;
  /** In-page sections for the table of contents. */
  toc?: { id: string; label: string }[];
}

const { id, title, toc = [] } = Astro.props;
---

<Section tone="cream" labelledby={id}>
  <div class:list={["legal", { "has-toc": toc.length > 1 }]}>
    {
      toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ol role="list">
            {toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="legal-body">
      <Eyebrow>Legal</Eyebrow>
      <h1 id={id}>{title}</h1>
      <div class="prose">
        <slot />
      </div>
    </div>
  </div>
</Section>

<style>
  .legal {
    display: grid;
    gap: 2.5rem;
    padding-top: 1rem;
  }

  @media (min-width: 1024px) {
    .has-toc {
      grid-template-columns: 220px minmax(0, 1fr);
      gap: 5rem;
    }

    .toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
      order: 0;
    }
  }

  @media (max-width: 1023px) {
    .toc {
      order: 1;
      display: none;
    }
  }

  .toc-title {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-800);
    margin-bottom: 0.75rem;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--hairline-light);
  }

  .toc a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding-left: 1rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--color-body);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--color-heading);
  }

  .legal-body {
    max-width: var(--measure);
  }

  .legal-body h1 {
    font-size: clamp(2.75rem, 3vw + 1rem, 4.5rem);
    margin-bottom: 2rem;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.75rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .prose :global(p) {
    max-width: var(--measure);
  }
</style>
