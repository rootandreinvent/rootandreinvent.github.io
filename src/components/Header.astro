---
import Wordmark from "./Wordmark.astro";
import BookCallButton from "./BookCallButton.astro";
import { site } from "../config/site";
import { url } from "../lib/url";

interface Props {
  /** The page opens on a dark hero: start transparent with light text. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const nav = [
  { href: "/work-with-me/", label: "Work with me" },
  { href: "/method/", label: "Method" },
  { href: "/shop/", label: "Shop" },
  { href: "/about/", label: "About" },
];

const current = Astro.url.pathname;
const isCurrent = (href: string) => current.startsWith(url(href));
---

<header class:list={["site-header", { overlay, "tone-dark": overlay }]} data-header data-overlay={overlay ? "" : undefined}>
  <div class="container bar">
    <a class="brand" href={url("/")} aria-label="Root & Reinvent home">
      <Wordmark variant="auto" compact />
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav-list" role="list">
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <BookCallButton label="Book a call" class="header-book" />

    <button class="menu-toggle" type="button" aria-haspopup="dialog" aria-controls="menu-overlay" data-menu-open>
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>

  <dialog class="menu-overlay tone-dark grain" id="menu-overlay" aria-label="Menu" data-menu>
    <div class="menu-inner">
      <div class="menu-top">
        <Wordmark variant="cream" />
        <button class="menu-close" type="button" data-menu-close>
          <span class="close-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <nav aria-label="Mobile">
        <ul class="menu-list" role="list">
          {
            [...nav, { href: "/guide/", label: "Free guide" }].map((item, i) => (
              <li style={`--i: ${i}`}>
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-bottom">
        <p class="menu-tagline">{site.tagline}</p>
        <BookCallButton />
      </div>
    </div>
  </dialog>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const menu = document.querySelector<HTMLDialogElement>("[data-menu]");
  const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  if (header) {
    const overlay = header.hasAttribute("data-overlay");
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      ticking = false;
      const y = window.scrollY;
      const scrolled = y > 40;
      header.classList.toggle("is-scrolled", scrolled);
      if (overlay) header.classList.toggle("tone-dark", !scrolled);
      const goingDown = y > lastY + 4;
      const goingUp = y < lastY - 4;
      if (goingDown && y > 200 && !header.matches(":focus-within")) header.classList.add("is-hidden");
      else if (goingUp || y <= 200) header.classList.remove("is-hidden");
      lastY = y;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    header.addEventListener("focusin", () => header.classList.remove("is-hidden"));
    update();
  }

  if (menu && openBtn && closeBtn) {
    openBtn.addEventListener("click", () => {
      menu.showModal();
      document.body.classList.add("menu-open");
      menu.classList.add("is-open");
    });
    closeBtn.addEventListener("click", () => menu.close());
    menu.addEventListener("close", () => {
      document.body.classList.remove("menu-open");
      menu.classList.remove("is-open");
      openBtn.focus();
    });
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) menu.close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--color-heading);
    background: var(--color-bg);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      color 0.35s ease,
      transform 0.45s var(--ease-out);
  }

  .site-header.overlay {
    margin-bottom: calc(-1 * var(--header-h));
    background: transparent;
  }

  .site-header.tone-dark {
    color: var(--color-on-band-strong);
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bone-50) 82%, transparent);
    border-bottom-color: var(--hairline-light);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    margin-right: auto;
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
  }

  .nav-list a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    color: inherit;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .nav-list a::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 8px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-list a:hover::after {
    transform: scaleX(1);
  }

  .nav-list a[aria-current="page"]::after {
    transform: scaleX(1);
    height: 1.5px;
    background: var(--gold-500);
  }

  .bar :global(.header-book) {
    min-height: 44px;
    padding: 0.55rem 1.1rem;
    font-size: 0.92rem;
  }

  .menu-toggle {
    display: none;
  }

  /* Mobile: the overlay menu needs JS; without it the links wrap under the wordmark. */
  @media (max-width: 899px) {
    .bar {
      gap: 0.6rem;
    }

    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
    }

    :global(html:not(.js)) .nav {
      order: 5;
      flex-basis: 100%;
    }

    :global(html:not(.js)) .nav-list {
      flex-wrap: wrap;
    }

    :global(.js) .nav {
      display: none;
    }

    .bar :global(.header-book) {
      padding: 0.5rem 0.9rem;
      font-size: 0.88rem;
    }

    .bar :global(.header-book .btn-arrow) {
      display: none;
    }

    :global(.js) .menu-toggle {
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      background: none;
      border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
      border-radius: 999px;
      color: inherit;
      cursor: pointer;
    }
  }

  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    position: relative;
  }

  .menu-icon::before {
    content: "";
    position: absolute;
    top: 6px;
    width: 12px;
  }

  .menu-icon {
    transform: translateY(-3px);
  }

  .menu-overlay {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--forest-950);
    color: var(--color-on-band);
  }

  .menu-overlay::backdrop {
    background: var(--forest-950);
  }

  .menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: 0 var(--gutter) 2rem;
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
  }

  .menu-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: none;
    border: 1px solid var(--hairline-dark);
    border-radius: 999px;
    color: var(--bone-50);
    cursor: pointer;
  }

  .close-icon {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .close-icon::before,
  .close-icon::after {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    transform: rotate(45deg);
  }

  .close-icon::after {
    transform: rotate(-45deg);
  }

  .menu-list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }

  .menu-list a {
    display: inline-flex;
    min-height: 56px;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 8vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--bone-50);
    text-decoration: none;
  }

  .menu-list a[aria-current="page"] {
    font-style: italic;
    color: var(--gold-500);
  }

  .menu-list li {
    opacity: 0;
    transform: translateY(16px);
  }

  .menu-overlay.is-open .menu-list li {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease,
      transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 60ms + 80ms);
  }

  .menu-bottom {
    margin-top: auto;
    padding-top: 2.5rem;
    border-top: 1px solid var(--hairline-dark);
  }

  .menu-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--color-on-band);
    margin-bottom: 1.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-list li {
      opacity: 1;
      transform: none;
    }
  }
</style>
