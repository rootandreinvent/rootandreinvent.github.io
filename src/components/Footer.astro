---
import { Image } from "astro:assets";
import badge from "../assets/logo-badge.jpg";
import SignupForm from "./SignupForm.astro";
import PlaceholderNote from "./PlaceholderNote.astro";
import RootLines from "./RootLines.astro";
import { site } from "../config/site";
import { url } from "../lib/url";
import { bookingHref } from "../lib/booking";

interface Props {
  showSignup?: boolean;
}

const { showSignup = true } = Astro.props;
const year = new Date().getFullYear();

const explore = [
  { href: "/work-with-me/", label: "Work with me" },
  { href: "/method/", label: "Method" },
  { href: "/shop/", label: "Shop" },
  { href: "/about/", label: "About" },
];

const start = [
  { href: "/guide/", label: "Free guide" },
  { href: bookingHref, label: "Book a call" },
];

const [before, after] = site.tagline.split("finding");
---

<footer class="site-footer tone-dark grain">
  <div class="divider">
    <RootLines variant="divider" tone="gold" />
  </div>

  <div class="container">
    <p class="closing" data-reveal>
      {before}<em>finding</em>{after}
    </p>

    <div class="grid-footer">
      <div class="brand-col">
        <Image
          src={badge}
          alt="Root & Reinvent. You've built it. Now grow it."
          width={112}
          height={112}
          widths={[112, 224, 336]}
          sizes="112px"
          class="badge"
        />
        <p class="contact">
          <span class="col-title">Email</span>
          <a class="email" href={`mailto:${site.email.contact}`}>{site.email.contact}</a>
        </p>
        {
          site.mailingAddress ? (
            <p class="address">{site.mailingAddress}</p>
          ) : (
            <PlaceholderNote text="[TODO: mailing address (PO box or virtual mailbox)]" />
          )
        }
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div>
          <p class="col-title">Explore</p>
          <ul role="list">
            {
              explore.map((item) => (
                <li>
                  <a href={url(item.href)}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="col-title">Start here</p>
          <ul role="list">
            {
              start.map((item) => (
                <li>
                  <a href={url(item.href)}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>

      <div class="signup-col">
        <p class="col-title">Get the free guide</p>
        {
          showSignup ? (
            <SignupForm source="footer" compact />
          ) : (
            <>
              <p>A template and three AI prompts that get replies.</p>
              <a class="guide-link" href={url("/guide/")}>
                Get the free guide <span aria-hidden="true">&rarr;</span>
              </a>
            </>
          )
        }
      </div>
    </div>

    <div class="legal">
      <p>&copy; {year} Root &amp; Reinvent</p>
      <ul role="list">
        <li><a href={url("/privacy/")}>Privacy</a></li>
        <li><a href={url("/terms/")}>Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--forest-950);
    color: var(--color-on-band);
    padding-block: 0 2rem;
    overflow: hidden;
  }

  .divider {
    height: 56px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .closing {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw + 0.5rem, 6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--bone-50);
    max-width: 14ch;
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    text-wrap: balance;
  }

  .closing em {
    color: var(--gold-500);
  }

  .grid-footer {
    display: grid;
    gap: 2.75rem;
    padding-top: 3rem;
    border-top: 1px solid var(--hairline-dark);
  }

  @media (min-width: 900px) {
    .grid-footer {
      grid-template-columns: 1fr 1.1fr 1.3fr;
      gap: 3rem;
    }
  }

  .badge {
    width: 112px;
    height: 112px;
    border-radius: 999px;
    margin-bottom: 1.5rem;
  }

  .col-title {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-500);
    margin: 0 0 0.75rem;
  }

  .contact {
    display: flex;
    flex-direction: column;
    margin: 0 0 0.75rem;
  }

  .contact .col-title {
    margin-bottom: 0;
  }

  .email {
    color: var(--bone-50);
    user-select: all;
    overflow-wrap: anywhere;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-nav ul,
  .legal ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    color: var(--bone-50);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1px;
    background-position: 0 85%;
    background-repeat: no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }

  .site-footer a:hover {
    background-size: 100% 1px;
  }

  .guide-link {
    gap: 0.4rem;
    font-weight: 600;
  }

  .signup-col p:not(.col-title) {
    margin: 0 0 0.25rem;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline-dark);
    font-size: var(--step--1);
    color: var(--color-on-band);
  }

  .legal p {
    margin: 0;
  }

  .legal ul {
    display: flex;
    gap: 1.5rem;
  }
</style>
