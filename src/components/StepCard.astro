---
import Card from "./Card.astro";
import { url } from "../lib/url";

interface Props {
  numeral: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { numeral, title, href, linkLabel } = Astro.props;
---

<Card href={href} class="step-card">
  <span class="numeral" aria-hidden="true">{numeral}</span>
  <h3>
    {
      href ? (
        <a class="stretched" href={url(href)}>
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p><slot /></p>
  {href && linkLabel && <span class="more" aria-hidden="true">{linkLabel} &rarr;</span>}
</Card>

<style>
  .numeral {
    display: block;
    color: var(--color-gold-ink);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 2.25rem;
    line-height: 1;
    margin-bottom: 0.9rem;
  }

  .numeral::after {
    content: ".";
  }

  :global(.tone-band) .numeral {
    color: var(--color-gold);
  }

  h3 {
    margin-bottom: 0.5rem;
  }

  p {
    margin: 0;
  }

  a.stretched {
    color: inherit;
    text-decoration: none;
  }

  a.stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  a.stretched:focus-visible {
    outline: none;
  }

  a.stretched:focus-visible::after {
    outline: 3px solid var(--color-teal);
    outline-offset: 3px;
  }

  :global(.tone-band) a.stretched:focus-visible::after {
    outline-color: var(--color-gold);
  }

  .more {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-teal);
  }

  :global(.tone-band) .more {
    color: var(--color-gold);
  }
</style>
