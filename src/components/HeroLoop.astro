---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { url } from "../lib/url";

const dir = join(process.cwd(), "public", "video");
const hasMp4 = existsSync(join(dir, "hero-loop.mp4"));
const hasWebm = existsSync(join(dir, "hero-loop.webm"));
---

<div class="hero-loop" aria-hidden="true">
  {
    (hasMp4 || hasWebm) && (
      <video muted autoplay loop playsinline preload="metadata" tabindex="-1">
        {hasWebm && <source src={url("/video/hero-loop.webm")} type="video/webm" />}
        {hasMp4 && <source src={url("/video/hero-loop.mp4")} type="video/mp4" />}
      </video>
    )
  }
</div>

<style>
  .hero-loop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(55% 70% at 8% 10%, color-mix(in srgb, var(--color-teal) 70%, transparent) 0%, transparent 70%),
      radial-gradient(45% 60% at 95% 90%, var(--color-band-raised) 0%, transparent 70%),
      radial-gradient(14% 18% at 78% 18%, color-mix(in srgb, var(--color-gold) 22%, transparent) 0%, transparent 100%),
      var(--color-band);
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }

  @media (prefers-reduced-motion: reduce) {
    video {
      display: none;
    }
  }
</style>
