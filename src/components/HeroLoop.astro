---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { site } from "../config/site";
import { url } from "../lib/url";

const src = existsSync(join(process.cwd(), "public", site.video.heroLoop)) ? url(site.video.heroLoop) : undefined;
---

<div class="hero-loop" aria-hidden="true" data-hero-loop data-src={src}></div>

<script>
  const holder = document.querySelector<HTMLElement>("[data-hero-loop]");
  const src = holder?.dataset.src;
  // Decorative: skipped on small screens (data) and under reduced motion.
  if (holder && src && matchMedia("(min-width: 768px) and (prefers-reduced-motion: no-preference)").matches) {
    const video = document.createElement("video");
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    video.autoplay = true;
    video.playsInline = true;
    video.preload = "auto";
    video.tabIndex = -1;
    video.setAttribute("aria-hidden", "true");
    video.src = src;
    holder.append(video);
    video.play().catch(() => {});
  }
</script>

<style>
  .hero-loop {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(55% 70% at 8% 10%, color-mix(in srgb, var(--color-teal) 70%, transparent) 0%, transparent 70%),
      radial-gradient(45% 60% at 95% 90%, var(--color-band-raised) 0%, transparent 70%),
      radial-gradient(14% 18% at 78% 18%, color-mix(in srgb, var(--color-gold) 22%, transparent) 0%, transparent 100%),
      var(--color-band);
  }

  .hero-loop :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .hero-loop :global(video) {
      display: none;
    }
  }
</style>
