---
import { site } from "../config/site";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import LogoStrip from "./LogoStrip.astro";

type Testimonial = { quote: string; name: string; title: string; company: string; headshot?: string };

/* Placeholder only. Replace with real, approved testimonials before turning on site.features.testimonials. */
const testimonials: Testimonial[] = [
  {
    quote: "[TODO: Placeholder quote. Replace with a real, approved testimonial.]",
    name: "[TODO: Name]",
    title: "[TODO: Title]",
    company: "[TODO: Company]",
  },
];
---

{
  site.features.testimonials && (
    <Section tone="bone" labelledby="testimonials-title">
      <SectionHeader id="testimonials-title" eyebrow="In their words">
        What people say.
      </SectionHeader>
      <div class="quotes">
        {testimonials.map((t) => (
          <figure class="quote">
            <blockquote>
              <p>{t.quote}</p>
            </blockquote>
            <figcaption>
              {t.headshot && <img src={t.headshot} alt="" width="56" height="56" class="headshot" loading="lazy" />}
              <span>
                <span class="name">{t.name}</span>
                <span class="role">
                  {t.title}, {t.company}
                </span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      <LogoStrip />
    </Section>
  )
}

<style>
  .quotes {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  .quote {
    margin: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline-light);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-heading);
    max-width: 28ch;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
    font-family: var(--font-ui);
  }

  .headshot {
    border-radius: 999px;
  }

  .name {
    display: block;
    font-weight: 600;
    color: var(--color-heading);
  }

  .role {
    color: var(--color-body);
  }
</style>
