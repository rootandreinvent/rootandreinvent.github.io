---
import Button from "./Button.astro";
import { site } from "../config/site";
import { bookingHref } from "../lib/booking";

interface Props {
  variant?: "primary" | "secondary";
  label?: string;
  class?: string;
}

const { variant = "primary", label = "Book a 15 to 20 minute call", class: className } = Astro.props;
---

<Button href={bookingHref} external={Boolean(site.booking.url)} variant={variant} class={className}>
  {label}
</Button>
