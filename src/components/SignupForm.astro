---
import { site } from "../config/site";
import { url } from "../lib/url";

interface Props {
  /** Where the signup came from, e.g. "guide-page". Sent to Kit so Kelsey can compare channels. */
  source: string;
  tag?: string;
  buttonLabel?: string;
  compact?: boolean;
  id?: string;
}

const { source, tag, buttonLabel = "Send me the free guide", compact = false, id } = Astro.props;
const action = site.signup.formActionUrl;
const enabled = Boolean(action);
const fieldId = `email-${source}`;
const errorId = `${fieldId}-error`;
const noteId = `${fieldId}-note`;
---

<form
  class:list={["signup", { compact, disabled: !enabled }]}
  id={id}
  method="post"
  action={action ?? undefined}
  novalidate
  data-signup
>
  <div class="controls">
    <div class="field">
      <input
        id={fieldId}
        name="email_address"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        placeholder=" "
        disabled={!enabled}
        aria-describedby={`${errorId} ${noteId}`}
      />
      <label for={fieldId} class="label">Email address</label>
    </div>
    <button class="submit" type="submit" disabled={!enabled}>
      <span class="submit-label">{enabled ? buttonLabel : "Signups open soon"}</span>
      <span class="spinner" aria-hidden="true"></span>
    </button>
  </div>
  <input type="hidden" name="fields[source]" value={source} />
  {tag && <input type="hidden" name="fields[signup_tag]" value={tag} />}
  <p class="error" id={errorId} role="alert" hidden>Enter a valid email address.</p>
  <p class="note" id={noteId}>
    We'll only use your email to send what you asked for. See the <a href={url("/privacy/")}>privacy policy</a>.
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-signup]").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const error = form.querySelector<HTMLElement>(".error");
    const submit = form.querySelector<HTMLButtonElement>(".submit");
    if (!input || !error || !submit) return;

    const validate = () => {
      const ok = input.checkValidity();
      error.hidden = ok;
      input.setAttribute("aria-invalid", String(!ok));
      return ok;
    };

    input.addEventListener("blur", () => {
      if (input.value) validate();
    });

    form.addEventListener("submit", (event) => {
      if (!validate()) {
        event.preventDefault();
        input.focus();
        return;
      }
      submit.classList.add("is-loading");
      submit.setAttribute("aria-busy", "true");
    });
  });
</script>

<style>
  .signup {
    width: 100%;
    max-width: 560px;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .field {
    position: relative;
    flex: 1 1 15rem;
  }

  input[type="email"] {
    width: 100%;
    min-height: 56px;
    padding: 1.45rem 1.1rem 0.45rem;
    font: inherit;
    font-size: 1rem;
    color: var(--color-heading);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .label {
    position: absolute;
    left: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    transform-origin: left center;
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--color-body);
    pointer-events: none;
    transition:
      transform 0.2s var(--ease-out),
      top 0.2s var(--ease-out);
  }

  input:focus + .label,
  input:not(:placeholder-shown) + .label {
    top: 0.9rem;
    transform: translateY(-50%) scale(0.78);
    font-weight: 600;
  }

  input[type="email"]:focus-visible {
    outline: 2px solid var(--gold-800);
    outline-offset: 2px;
    border-color: var(--gold-800);
  }

  input[aria-invalid="true"] {
    border-color: var(--clay-700);
  }

  .submit {
    position: relative;
    flex: 0 0 auto;
    min-height: 56px;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-button);
    border: 1px solid var(--forest-900);
    background: var(--forest-900);
    color: var(--bone-50);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .submit:hover:not([disabled]) {
    background: var(--forest-800);
    transform: translateY(-1px);
  }

  .spinner {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 999px;
    opacity: 0;
  }

  .submit.is-loading .submit-label {
    visibility: hidden;
  }

  .submit.is-loading .spinner {
    opacity: 1;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .submit[disabled],
  input[disabled] {
    cursor: not-allowed;
  }

  .disabled input[disabled] {
    opacity: 0.7;
  }

  .submit[disabled] {
    background: transparent;
    color: var(--color-heading);
    border-style: dashed;
  }

  .error {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--clay-700);
  }

  .note {
    margin: 0.75rem 0 0;
    font-size: var(--step--1);
    color: var(--color-body);
  }

  :global(.tone-dark) input[type="email"] {
    background: color-mix(in srgb, var(--bone-50) 7%, transparent);
    border-color: var(--hairline-dark);
    color: var(--bone-50);
  }

  :global(.tone-dark) .label {
    color: var(--color-on-band);
  }

  :global(.tone-dark) .submit {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: var(--forest-950);
  }

  :global(.tone-dark) .submit:hover:not([disabled]) {
    background: var(--gold-600);
  }

  :global(.tone-dark) .submit[disabled] {
    background: transparent;
    color: var(--gold-500);
    border-color: var(--gold-500);
  }

  :global(.tone-dark) .note {
    color: var(--color-on-band);
  }

  :global(.tone-dark) .note a {
    color: var(--color-on-band-strong);
  }

  :global(.tone-dark) .error {
    color: var(--gold-500);
  }

  :global(.tone-dark) input[type="email"]:focus-visible {
    outline-color: var(--gold-500);
    border-color: var(--gold-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .submit.is-loading .spinner {
      animation-duration: 2s;
    }
  }
</style>
