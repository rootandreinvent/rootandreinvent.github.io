---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { url } from "../lib/url";

interface Props {
  src: string;
  poster: string;
  captions?: string;
  /** Accessible name for the player. */
  title: string;
  durationLabel: string;
  aspect?: "16/9" | "4/5";
  maxWidth?: string;
  /** Poster `sizes`; defaults to the max width. */
  sizes?: string;
  /** Above-the-fold poster: load eagerly with high priority. */
  eager?: boolean;
  class?: string;
}

const {
  src,
  poster,
  captions,
  title,
  durationLabel,
  aspect = "16/9",
  maxWidth = "100%",
  sizes,
  eager = false,
  class: className,
} = Astro.props;

const inPublic = (path?: string) => Boolean(path) && existsSync(join(process.cwd(), "public", path!));
const ready = inPublic(src);
const captionsHref = captions && inPublic(captions) ? url(captions) : undefined;

const [ratioW, ratioH] = aspect === "4/5" ? [4, 5] : [16, 9];
const posterName = poster.split("/").pop();
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/video/*.jpg", { eager: true });
const posterAsset = Object.entries(posters).find(([path]) => path.endsWith(`/${posterName}`))?.[1].default;
const posterSizes =
  sizes ?? (maxWidth.endsWith("px") ? `(min-width: ${maxWidth}) ${maxWidth}, 100vw` : "(min-width: 1120px) 1056px, 100vw");
const loading = eager ? "eager" : "lazy";
---

<div
  class:list={["brand-video", { "is-missing": !ready }, className]}
  style={`--video-max: ${maxWidth}; --video-ratio: ${ratioW} / ${ratioH};`}
  data-brand-video
>
  <div class="frame">
    <div class="poster-wrap" data-parallax="10">
      {
        posterAsset ? (
          <Image
            src={posterAsset}
            alt=""
            class="poster"
            widths={[480, 960, 1440, posterAsset.width].filter((w) => w <= posterAsset.width)}
            sizes={posterSizes}
            loading={loading}
            fetchpriority={eager ? "high" : undefined}
            decoding="async"
          />
        ) : (
          inPublic(poster) && <img src={url(poster)} alt="" class="poster" loading={loading} decoding="async" />
        )
      }
    </div>
    <span class="scrim" aria-hidden="true"></span>
    {
      ready && (
        <a
          class="play"
          href={url(src)}
          data-play
          data-src={url(src)}
          data-poster={url(poster)}
          data-captions={captionsHref}
          data-title={title}
          data-aspect={aspect}
          aria-label={`Watch · ${durationLabel}: ${title}`}
        >
          <span class="play-btn" aria-hidden="true">
            <span class="play-ring" />
            <svg viewBox="0 0 24 24" class="play-glyph">
              <path d="M8 5.5v13l10.5-6.5z" />
            </svg>
          </span>
          <span class="label" aria-hidden="true">
            Watch <span class="dot">·</span> {durationLabel}
          </span>
        </a>
      )
    }
    <p class="soon">Video available soon</p>
  </div>
</div>

<style>
  .brand-video {
    width: 100%;
    max-width: var(--video-max);
  }

  .frame {
    position: relative;
    aspect-ratio: var(--video-ratio);
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--forest-900);
    border: 1px solid color-mix(in srgb, var(--sage-200) 70%, transparent);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  :global(.tone-dark) .frame {
    border-color: var(--hairline-gold);
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.65),
      0 0 0 1px color-mix(in srgb, var(--gold-500) 8%, transparent);
  }

  .poster-wrap {
    position: absolute;
    inset: -6% 0;
  }

  .poster-wrap :global(.poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--forest-950) 0%, transparent) 50%,
      color-mix(in srgb, var(--forest-950) 88%, transparent) 100%
    );
    pointer-events: none;
  }

  .play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: 1rem;
    padding: clamp(0.9rem, 2.4vw, 1.6rem);
    color: var(--bone-50);
    text-decoration: none;
    border-radius: inherit;
  }

  .play:focus-visible {
    outline: 2px solid var(--gold-500);
    outline-offset: -8px;
    border-radius: var(--radius-media);
  }

  .play-btn {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(52px, 5.5vw, 72px);
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--gold-500);
    color: var(--forest-950);
    box-shadow: 0 14px 34px -10px rgb(0 0 0 / 0.55);
    transition:
      transform 0.4s var(--ease-out),
      background-color 0.25s ease;
  }

  .play-ring {
    position: absolute;
    inset: -10px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--gold-500) 80%, transparent);
    animation: pulse 2.8s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.92);
      opacity: 0.9;
    }
    80%,
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  .play-glyph {
    width: 38%;
    height: auto;
    margin-left: 8%;
    fill: currentColor;
  }

  .play:hover .play-btn,
  .play:focus-visible .play-btn {
    transform: scale(1.06);
    background: var(--gold-600);
  }

  .play:hover :global(.poster) {
    transform: scale(1.03);
  }

  .label {
    margin-bottom: clamp(0.6rem, 1.2vw, 1rem);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-button);
    background: color-mix(in srgb, var(--forest-950) 82%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--bone-50);
  }

  .dot {
    color: var(--gold-500);
  }

  .soon {
    display: none;
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-button);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--bone-50);
    background: color-mix(in srgb, var(--forest-950) 85%, transparent);
    border: 1px solid var(--hairline-gold);
  }

  .is-missing .play {
    display: none;
  }

  .is-missing .soon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .play-ring {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
