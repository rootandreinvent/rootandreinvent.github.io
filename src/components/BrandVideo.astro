---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { url } from "../lib/url";

interface Props {
  src: string;
  poster: string;
  captions?: string;
  /** Accessible name for the player. */
  title: string;
  durationLabel: string;
  aspect?: "16/9" | "4/5";
  maxWidth?: string;
  /** Poster `sizes`; defaults to the max width. */
  sizes?: string;
  /** Above-the-fold poster: load eagerly with high priority. */
  eager?: boolean;
}

const { src, poster, captions, title, durationLabel, aspect = "16/9", maxWidth = "100%", sizes, eager = false } = Astro.props;

const inPublic = (path?: string) => Boolean(path) && existsSync(join(process.cwd(), "public", path!));
const ready = inPublic(src);
const captionsHref = captions && inPublic(captions) ? url(captions) : undefined;

const [ratioW, ratioH] = aspect === "4/5" ? [4, 5] : [16, 9];
const posterName = poster.split("/").pop();
const posters = import.meta.glob<{ default: ImageMetadata }>("../assets/video/*.jpg", { eager: true });
const posterAsset = Object.entries(posters).find(([path]) => path.endsWith(`/${posterName}`))?.[1].default;
const posterSizes = sizes ?? (maxWidth.endsWith("px") ? `(min-width: ${maxWidth}) ${maxWidth}, 100vw` : "(min-width: 1120px) 1056px, 100vw");
const loading = eager ? "eager" : "lazy";
---

<div
  class:list={["brand-video", { "is-missing": !ready }]}
  style={`--video-max: ${maxWidth}; --video-ratio: ${ratioW} / ${ratioH};`}
  data-brand-video
  data-src={ready ? url(src) : undefined}
  data-poster={url(poster)}
  data-captions={captionsHref}
  data-title={title}
>
  <div class="frame">
    {
      posterAsset ? (
        <Image
          src={posterAsset}
          alt=""
          class="poster"
          widths={[480, 960, 1440, posterAsset.width].filter((w) => w <= posterAsset.width)}
          sizes={posterSizes}
          loading={loading}
          fetchpriority={eager ? "high" : undefined}
          decoding="async"
        />
      ) : (
        inPublic(poster) && <img src={url(poster)} alt="" class="poster" loading={loading} decoding="async" />
      )
    }
    {
      ready && (
        <a class="play" href={url(src)} data-play aria-label={`Play video: ${title} (${durationLabel})`}>
          <span class="play-icon" aria-hidden="true" />
          <span class="label" aria-hidden="true">Watch · {durationLabel}</span>
        </a>
      )
    }
    <p class="soon">Video coming soon</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-brand-video]").forEach((root) => {
    const play = root.querySelector<HTMLAnchorElement>("[data-play]");
    const frame = root.querySelector<HTMLElement>(".frame");
    const { src, poster, captions, title } = root.dataset;
    if (!play || !frame || !src) return;

    // Without JS the link opens the MP4 in the browser's own player.
    play.setAttribute("role", "button");

    const start = (event: Event) => {
      event.preventDefault();
      const video = document.createElement("video");
      video.src = src;
      if (poster) video.poster = poster;
      video.controls = true;
      video.playsInline = true;
      video.preload = "metadata";
      video.autoplay = true;
      video.setAttribute("aria-label", title ?? "");
      if (captions) {
        // Captions are burned in, so the track stays off by default.
        const track = document.createElement("track");
        track.kind = "captions";
        track.src = captions;
        track.srclang = "en";
        track.label = "English";
        video.append(track);
      }
      video.addEventListener(
        "error",
        () => {
          video.remove();
          root.classList.remove("is-playing");
          root.classList.add("is-missing");
        },
        { once: true },
      );
      frame.append(video);
      root.classList.add("is-playing");
      video.play().catch(() => {});
      video.focus();
    };

    play.addEventListener("click", start);
    play.addEventListener("keydown", (event) => {
      if (event.key === " ") start(event);
    });
  });
</script>

<style>
  .brand-video {
    width: 100%;
    max-width: var(--video-max);
  }

  .frame {
    position: relative;
    aspect-ratio: var(--video-ratio);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-band);
    border: 2px solid var(--color-border);
    box-shadow: 0 18px 40px -24px rgb(23 52 46 / 0.55);
  }

  :global(.tone-band) .frame {
    border: 0;
    box-shadow: 0 18px 44px -22px rgb(0 0 0 / 0.6);
  }

  .frame :global(.poster),
  .frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .frame :global(video) {
    object-fit: contain;
    background: var(--color-band);
  }

  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--color-on-band-strong);
    text-decoration: none;
    background: rgb(23 52 46 / 0.12);
  }

  .play:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: -6px;
    border-radius: var(--radius-card);
  }

  .play-icon {
    width: clamp(72px, 9vw, 88px);
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--color-gold);
    position: relative;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.5);
    transition: transform 0.15s ease, background-color 0.15s ease;
  }

  .play-icon::after {
    content: "";
    position: absolute;
    left: 54%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.8rem 0 0.8rem 1.3rem;
    border-color: transparent transparent transparent var(--color-band);
  }

  .play:hover .play-icon,
  .play:focus-visible .play-icon {
    background: var(--color-gold-hover);
    transform: scale(1.05);
  }

  .label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(23 52 46 / 0.9);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-on-band-strong);
  }

  .soon {
    display: none;
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    max-width: none;
    padding: 0.75rem 1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    text-align: center;
    color: var(--color-on-band-strong);
    background: rgb(23 52 46 / 0.85);
  }

  .is-playing .play,
  .is-playing :global(.poster) {
    display: none;
  }

  .is-missing .play {
    display: none;
  }

  .is-missing .soon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .play-icon {
      transition: none;
    }
  }
</style>
