---
import { showPending } from "../lib/placeholders";

interface Props {
  /** Full bracketed text, e.g. "[KELSEY TO CONFIRM]". Defaults to "[TODO: <note>]". */
  text?: string;
  note?: string;
  /** Required content with no fallback: renders in production so the placeholder check fails the build. */
  blocking?: boolean;
}

const { text, note = "", blocking = false } = Astro.props;
const label = text ?? `[TODO: ${note}]`;
---

{showPending && <span class="todo-chip">{label}</span>}
{!showPending && blocking && <span>{label}</span>}

<style>
  .todo-chip {
    display: inline-block;
    background: var(--color-todo-bg);
    color: var(--color-todo-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.3;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    vertical-align: middle;
    margin: 0.15rem 0.25rem;
    white-space: normal;
  }
</style>
