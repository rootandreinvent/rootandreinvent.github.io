---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<p class:list={["eyebrow", className]}><slot /></p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-800);
    margin: 0 0 1.25rem;
  }

  .eyebrow::before {
    content: "";
    flex: none;
    width: 24px;
    height: 1px;
    background: currentColor;
  }

  :global(.tone-dark) .eyebrow,
  :global(.site-footer) .eyebrow {
    color: var(--gold-500);
  }
</style>
