---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Button from "../../components/Button.astro";
import { getMethodPosts } from "../../lib/content";
import { url } from "../../lib/url";

const prioritize = (await getMethodPosts()).find((p) => p.data.slug === "prioritize");
---

<BaseLayout
  title="Check your inbox"
  description="Confirm your email to get the free guide."
  noindex
  footerSignup={false}
  overlayHeader
>
  <PageHero id="thanks-title" eyebrow="Free guide">
    Check your inbox <em>to confirm.</em>
    <div slot="lead">
      <p>Your guide is on the way.</p>
      {
        prioritize && (
          <p>
            While you wait, read: <a href={url("/method/prioritize/")}>Prioritize: who to call first</a>.
          </p>
        )
      }
    </div>
    {!prioritize && <Button slot="actions" href="/method/" variant="secondary">Read about the method</Button>}
  </PageHero>
</BaseLayout>
