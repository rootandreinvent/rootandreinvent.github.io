---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import StepCard from "../components/StepCard.astro";
import StatPanel from "../components/StatPanel.astro";
import BookCallButton from "../components/BookCallButton.astro";
import BrandVideo from "../components/BrandVideo.astro";
import PlaceholderNote from "../components/PlaceholderNote.astro";
import CareerPath from "../components/CareerPath.astro";
import Card from "../components/Card.astro";
import { builds } from "../data/credentials";
import { personLd, videoLd } from "../lib/jsonld";
import { videoProps } from "../lib/video";
import portrait from "../assets/kelsey-interim.jpg";
---

<BaseLayout
  title="About Kelsey"
  description="Kelsey Dalton is a revenue and go-to-market leader with more than ten years in sales who led net-new-logo teams in enterprise technology. Now she teaches the Repeat Success Method."
  jsonLd={[personLd(Astro.site), videoLd("main", Astro.site)]}
>
  <Section tone="cream" labelledby="about-title">
    <div class="about">
      <figure class="portrait">
        <Image
          src={portrait}
          alt="Kelsey Dalton, founder of Root & Reinvent"
          widths={[328, 656]}
          sizes="(min-width: 900px) 328px, 80vw"
          loading="eager"
        />
        <PlaceholderNote text="[TODO: professional headshot; this is a low-resolution interim crop]" />
      </figure>
      <div>
        <Eyebrow>About</Eyebrow>
        <h1 id="about-title">About Kelsey</h1>
        <p class="lede">
          I'm a revenue and go-to-market leader with more than ten years in sales, most of it in enterprise technology.
          I started in inside sales, came into tech as a BDR, moved up through account executive roles, then led
          net-new-logo teams as a sales manager, a Regional Sales Director, a Regional Vice President and a Senior
          Director.
        </p>
        <p>
          I've driven new-logo growth across SaaS, AI, cloud and manufacturing. Landing new logos was the job. I built a
          repeatable way to do it, and now I teach it through coaching, workshops and the Repeat Success Method.
        </p>
        <PlaceholderNote text="[KELSEY TO CONFIRM bio wording and titles]" />
        <div class="button-row">
          <BookCallButton />
        </div>
      </div>
    </div>
    <div class="about-video">
      <BrandVideo {...videoProps("main")} maxWidth="880px" />
    </div>
  </Section>

  <Section tone="band" id="record" labelledby="record-title">
    <Eyebrow>Track record</Eyebrow>
    <h2 id="record-title">
      10+ years of winning new logos and leading the teams that win them.
      <span class="accent">The results behind the method.</span>
    </h2>
    <StatPanel />
  </Section>

  <Section tone="cream" labelledby="path-title">
    <Eyebrow>Career path</Eyebrow>
    <h2 id="path-title">From inside sales rep to Senior Director.</h2>
    <p class="lede">Every step was about landing new logos, first as a seller, then as the leader building the team.</p>
    <CareerPath />
  </Section>

  <Section tone="band" labelledby="built-title">
    <Eyebrow>What I built</Eyebrow>
    <h2 id="built-title">The systems behind the numbers.</h2>
    <ul class="grid grid-3 builds" role="list">
      {
        builds.map((item) => (
          <Card tag="li">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </Card>
        ))
      }
    </ul>
  </Section>

  <Section tone="cream" labelledby="how-title">
    <Eyebrow>How I work</Eyebrow>
    <h2 id="how-title">Three principles.</h2>
    <div class="grid grid-3 cards">
      <StepCard numeral="1" title="An invitation, not a pitch.">
        You are not asking them to buy. You are asking whether a conversation is worth their time.
      </StepCard>
      <StepCard numeral="2" title="Never invent a number.">
        Use only results you're approved to share. Don't round up.
      </StepCard>
      <StepCard numeral="3" title="Small asks, real proof.">
        A similar customer, a real challenge, a measurable result, and a 15 to 20 minute ask.
      </StepCard>
    </div>
    <div class="button-row">
      <BookCallButton />
    </div>
  </Section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 328px minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .portrait {
    margin: 0;
    max-width: 328px;
  }

  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1.5px solid var(--color-border);
  }

  .cards,
  .builds {
    margin-top: 2.5rem;
  }

  .builds {
    list-style: none;
    padding: 0;
  }

  .builds h3 {
    margin-bottom: 0.5rem;
    text-wrap: pretty;
  }

  .builds p {
    margin: 0;
  }

  .about-video {
    display: grid;
    justify-items: center;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }
</style>
