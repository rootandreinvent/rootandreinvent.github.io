---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PageHero from "../../components/PageHero.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import MethodSteps from "../../components/MethodSteps.astro";
import EmailAnatomy from "../../components/EmailAnatomy.astro";
import GuideBand from "../../components/GuideBand.astro";
import BrandVideo from "../../components/BrandVideo.astro";
import { getMethodPosts } from "../../lib/content";
import { videoLd } from "../../lib/jsonld";
import { videoProps } from "../../lib/video";

const published = (await getMethodPosts()).map((p) => p.data.slug);
---

<BaseLayout
  title="The Repeat Success Method"
  description="A repeatable way to land new logos in four parts: Prioritize, People, Proof and Persistence. Plus the three-part first email."
  footerSignup={false}
  overlayHeader
  jsonLd={videoLd("walkthrough", Astro.site)}
>
  <PageHero id="method-title" eyebrow="The method">
    The Repeat Success <em>Method</em>
    <p slot="lead">
      A repeatable way to land new logos: a short, researched, proof-based first email that earns a 15 to 20 minute
      meeting, and the work around it.
    </p>
    <div slot="aside" class="hero-video">
      <BrandVideo {...videoProps("walkthrough")} eager sizes="(min-width: 1024px) 40vw, 100vw" />
    </div>
  </PageHero>

  <Section tone="deep" labelledby="steps-title">
    <MethodSteps published={published}>
      <div slot="header">
        <Eyebrow>The four parts</Eyebrow>
        <h2 id="steps-title">A <em>repeatable</em> way to land new logos.</h2>
      </div>
    </MethodSteps>
  </Section>

  <Section tone="bone" labelledby="framework-title">
    <SectionHeader id="framework-title" eyebrow="The Repeat Success Framework">
      Every first email has three parts. <em>Nothing else.</em>
      <p slot="lead">
        You are not asking them to buy. You are asking whether a conversation is worth their time, which is a much
        smaller ask and easier to say yes to.
      </p>
    </SectionHeader>
    <EmailAnatomy />
  </Section>

  <GuideBand source="method-overview" headingId="signup-title">
    Get the <em>free guide.</em>
    <p slot="lead">A template and three AI prompts that get replies.</p>
  </GuideBand>
</BaseLayout>
