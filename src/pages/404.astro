---
import BaseLayout from "../layouts/BaseLayout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import RootLines from "../components/RootLines.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex overlayHeader footerSignup={false}>
  <section class="nf tone-dark grain" aria-labelledby="nf-title">
    <div class="nf-roots" aria-hidden="true">
      <RootLines variant="hero" tone="gold" />
    </div>
    <div class="container nf-inner">
      <p class="code" aria-hidden="true">404</p>
      <Eyebrow>Page not found</Eyebrow>
      <h1 id="nf-title">This lead went <em>cold.</em></h1>
      <p class="lede">This page doesn't exist. It may have moved, or the link may be wrong.</p>
      <div class="button-row">
        <Button href="/">Back to home</Button>
        <Button href="/guide/" variant="secondary">Get the free guide</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: center;
    background: var(--forest-900);
    padding-top: calc(var(--header-h) + 4rem);
    padding-bottom: 6rem;
    overflow: hidden;
  }

  .nf-roots {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.8;
  }

  .nf-inner {
    position: relative;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(7rem, 18vw, 16rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    margin: 0 0 2.5rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold-500);
  }

  h1 {
    font-size: clamp(3rem, 5vw + 1rem, 6.5rem);
    max-width: 12ch;
  }

  .lede {
    max-width: 40ch;
  }
</style>
